# 服务端口
PORT=8787

# 监听地址。默认 127.0.0.1（仅本机）；容器内需要 0.0.0.0
HOST=127.0.0.1

# SQLite 文件位置；相对路径按 apps/api 解析
DATABASE_URL=file:./data/dnsit.db

# 可选：32 字节主密钥（base64 或 64 位 hex）。
# 不填则自动生成 data/master.key（权限 0600）。
# 注意：丢失主密钥后，已保存的 AK/SK 无法解密，只能重新录入。
# DNSIT_MASTER_KEY=

# 全实例只读开关，1 = 禁止任何写操作
# DNSIT_READONLY=0

# 反向代理后的公开来源，逗号分隔；写请求的 Origin 校验依赖它
# DNSIT_ALLOWED_ORIGINS=https://dnsit-sg.refme.cc

# 各云账号的请求节流（每秒请求数），低于官方上限以规避限流
ALIYUN_QPS=5
TENCENT_QPS=10

# 缓存 TTL（秒）
RECORD_CACHE_TTL=120
ZONE_CACHE_TTL=300
